#!/bin/bash

# Allowed user email to push to main/master
ALLOWED_EMAIL="slash-gil@outlook.com"
CURRENT_EMAIL=$(git config user.email)

# Read the push input
while read local_ref local_sha remote_ref remote_sha
do
    # Check if the destination branch is main or master
    if [[ "$remote_ref" == *"refs/heads/main"* ]] || [[ "$remote_ref" == *"refs/heads/master"* ]]; then
        if [ "$CURRENT_EMAIL" != "$ALLOWED_EMAIL" ]; then
            echo ""
            echo "============================================================"
            echo "❌ ERROR: Push rejected by pre-push hook."
            echo "Only the authorized user ($ALLOWED_EMAIL) is allowed to push directly to main/master."
            echo "Your current git email is configured as: $CURRENT_EMAIL"
            echo "Please create a new branch and submit a Pull Request instead."
            echo "============================================================"
            echo ""
            exit 1
        fi
    fi
done

exit 0
